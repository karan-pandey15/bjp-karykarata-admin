# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_
# Real `.env` files are gitignored — never commit secrets.

# API base URL (include /api suffix)
# Local backend:
VITE_API_BASE_URL=https://api.pracharpost.in/api

# Production example:
# VITE_API_BASE_URL=https://api.pracharpost.in/api

# Optional app label
VITE_APP_NAME=BJP Karyakarta
